# 文档服务根地址（必填，不带结尾斜杠）。多环境下这里是默认地址（test 实例用）
GWMS_DOC_BASE_URL=http://your-doc-host:port

# 环境专属地址（可选）：GWMS_ENV_NAME=dev 的实例优先用它，可按需增加更多环境
# GWMS_DOC_BASE_URL_DEV=http://your-dev-doc-host:port

# 当前实例的环境名（可选）：设置后工具名带前缀、缓存目录隔离到 .cache/<环境名>/
# GWMS_ENV_NAME=dev

# 以下均为可选，留空则使用默认值

# springdoc/knife4j 元数据路径（默认 /v3/api-docs）
# GWMS_API_DOCS_PATH=/v3/api-docs

# 缓存目录（默认 <项目目录>/.cache，多环境为 <项目目录>/.cache/<环境名>）
# GWMS_CACHE_DIR=

# 缓存有效期，毫秒（默认 21600000 = 6 小时）
# GWMS_CACHE_TTL_MS=21600000

# 单个 HTTP 请求超时，毫秒（默认 60000）
# GWMS_REQUEST_TIMEOUT_MS=60000

# 详情中数据模型默认展开层级（默认 8）
# GWMS_MAX_SCHEMA_DEPTH=8

# 指定别的 .env 文件位置（默认项目根目录 .env）
# GWMS_ENV_FILE=
